# This file was generated by Appraisal

source "https://rubygems.org"

gem "activerecord", "~> 8.1.0"
case ENV["DB"]
when "postgresql"
  gem 'pg', '~> 1.5'
when "mysql"
  gem 'mysql2', '~> 0.5'
when "trilogy"
  gem 'trilogy', '~> 2.9'
else
  gem 'sqlite3', '>= 2.1'
end

group :local_development do
  gem "guard"
  gem "guard-rspec"
  gem "appraisal"
  gem "rake"
  gem "byebug", platforms: [:mri]
end

gemspec path: "../"
